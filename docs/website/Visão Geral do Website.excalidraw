      "link": null,
      "locked": false,
      "text": "src/\n├── app/\n│   ├── router/                 # configuração do React Router\n│   ├── providers/              # QueryClient, tema etc.\n│   └── config/                 # configuração da aplicação\n│\n├── pages/\n│   ├── home/                   # composição da Home\n│   ├── projects/               # lista e detalhe\n│   ├── budget/                 # orçamento\n│   └── privacy/                # privacidade\n│\n├── components/\n│   ├── ui/                     # Button, Input, Card...\n│   ├── layout/                 # Header, Footer, MobileMenu\n│   ├── home/                   # Hero, About, Services, Projects...\n│   ├── projects/               # ProjectCard, Gallery, Info\n│   └── budget/                 # BudgetForm, FileUpload...\n│\n├── hooks/                      # hooks reutilizáveis\n├── lib/\n│   ├── api/                    # client + chamadas por recurso\n│   ├── validation/          \n│   ├── format/                 # data, moeda, telefone\n│   └── utils.ts\n├── types/                      # contratos TypeScript\n├── styles/\n│   └── globals.css             # estilos realmente globais\n└── main.tsx",
      "fontSize": 7.931662870159451,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "src/\n├── app/\n│   ├── router/                 # configuração do React Router\n│   ├── providers/              # QueryClient, tema etc.\n│   └── config/                 # configuração da aplicação\n│\n├── pages/\n│   ├── home/                   # composição da Home\n│   ├── projects/               # lista e detalhe\n│   ├── budget/                 # orçamento\n│   └── privacy/                # privacidade\n│\n├── components/\n│   ├── ui/                     # Button, Input, Card...\n│   ├── layout/                 # Header, Footer, MobileMenu\n│   ├── home/                   # Hero, About, Services, Projects...\n│   ├── projects/               # ProjectCard, Gallery, Info\n│   └── budget/                 # BudgetForm, FileUpload...\n│\n├── hooks/                      # hooks reutilizáveis\n├── lib/\n│   ├── api/                    # client + chamadas por recurso\n│   ├── validation/          \n│   ├── format/                 # data, moeda, telefone\n│   └── utils.ts\n├── types/                      # contratos TypeScript\n├── styles/\n│   └── globals.css             # estilos realmente globais\n└── main.tsx",
